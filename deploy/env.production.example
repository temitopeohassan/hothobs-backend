# Server copy of .env — upload to /srv/hothobs-backend/.env and chmod 600.
# Differs from the local dev .env in NODE_ENV and DATABASE_FILE.

NODE_ENV=production
PORT=4000

CORS_ORIGIN=https://hothobscuisines.com

# Absolute, not ./data/hothobs.db — a relative path resolves against the
# process's working directory and silently creates a second, empty database
# if anything ever starts the app from elsewhere.
DATABASE_FILE=/srv/hothobs-backend/data/hothobs.db

# Keep the same value as the live site already uses. Changing it signs everyone out.
JWT_SECRET=REPLACE_ME
SESSION_DAYS=7

# false is correct: api.hothobscuisines.com and hothobscuisines.com share a
# registrable domain, so they are same-site and SameSite=Lax cookies are sent.
CROSS_SITE_COOKIES=false

SITE_URL=https://hothobscuisines.com

# Still test keys — swap for sk_live_/pk_live_ when the Paystack account is live.
PAYSTACK_SECRET_KEY=sk_test_3d38b8bd21b28b5a51d3b79bc8ec7107525e154b
PAYSTACK_PUBLIC_KEY=pk_test_45ef9971a52eca33f16889970d3b8bf962994a42
PAYSTACK_CURRENCY=NGN
