# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000

# Browser origins allowed to call this API with cookies (comma separated).
CORS_ORIGIN=http://localhost:5173

# Where the SQLite file lives. Must be on a persistent disk in production.
DATABASE_FILE=./data/hothobs.db

# ── Database (PostgreSQL) ──────────────────────────────────────────
# Nothing reads these yet: src/db.js still opens the SQLite file above via
# node:sqlite. They are here for the Postgres migration.

# One connection string carries user, password, host, port and database:
#   postgres://USER:PASSWORD@HOST:PORT/DATABASE
# URL-encode the password if it contains any of @ : / ? # %
DATABASE_URL=postgres://hothobs:CHANGE_ME@localhost:5432/hothobs

# require for any managed Postgres (Neon, Supabase, RDS, Render) — they all
# terminate TLS. disable is only safe for a Postgres on this same machine.
PGSSLMODE=disable

# Max connections this process holds open. The total across every running
# instance has to stay under the server's max_connections (default 100).
PGPOOL_MAX=10

# Signs session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everyone out.
JWT_SECRET=

# How many days a login lasts.
SESSION_DAYS=7

# Set true only when the API is on a different domain from the site in
# production. Forces SameSite=None; Secure on the session cookie.
CROSS_SITE_COOKIES=false

# ── Payment (Paystack) ─────────────────────────────────────────────
# Paystack is the only payment method. Without a secret key the checkout
# will refuse to take orders rather than quietly accepting unpaid ones.

# Where the customer-facing site lives. Paystack redirects people back to
# SITE_URL/order/complete after they pay, so in production this must be the
# real public origin (e.g. https://hothobscuisines.com).
SITE_URL=http://localhost:5173

# From the Paystack dashboard, Settings -> API Keys & Webhooks.
# Use the sk_test_... key until the account is live. NEVER commit this.
PAYSTACK_SECRET_KEY=

# Almost certainly NGN. Must be a currency the Paystack account is enabled for.
PAYSTACK_CURRENCY=NGN

# Set the webhook URL in the same Paystack dashboard screen to:
#   https://<this API's public origin>/api/payments/webhook
# It is what confirms an order when a customer pays and then closes the tab.
